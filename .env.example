TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required: Telegram numeric user id of the owner.
# The bot serves ONLY this user; messages from anyone else are silently ignored.
# Without it the bot refuses to start (fail closed).
HEALTH_OS_OWNER_ID=

# Optional
ANTHROPIC_MODEL=claude-3-5-haiku-latest
HEALTH_OS_TIMEZONE=Asia/Omsk
